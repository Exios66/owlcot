# ============================================================
# Owlcot — Git ignore rules
# ============================================================

# ---------- Built site & deploy artifacts ----------
site/
*.backup
*.bak
*.orig
*.rej

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.env.*
!.env.example
venv/
venv.bak/
.venv/
env/
ENV/
pip-wheel-metadata/
dist/
build/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.ipynb_checkpoints/

# ---------- Node (if ever used) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# ---------- Logs ----------
*.log
logs/

# ---------- Secrets ----------
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
*.secret
.secrets
credentials

# ---------- Editors & IDEs ----------
.idea/
.vscode/
*.swp
*.swo
*~
.vscode-server/
.history/
.idea/

# ---------- macOS / Windows ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Icon?
.Spotlight-V100/
.Trash-*
.fseventsd/
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Misc ----------
*.tmp
*.temp
*.crdownload
.cache/
.opencode/
